{
  "name": "agent-plugin-lifecycle",
  "version": "0.3.0",
  "description": "Run the install scripts that agent plugins and skills ship in apl.json, after you approve them: for Agent Package Manager (APM), npx skills and any other installer",
  "keywords": [
    "apm",
    "agent",
    "skills",
    "plugin",
    "install",
    "scripts",
    "lifecycle",
    "approval",
    "agent-package-manager",
    "agent-skills",
    "agent-plugins",
    "npx-skills",
    "install-scripts",
    "postinstall",
    "allow-scripts",
    "apl"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kmalakoff/agent-plugin-lifecycle.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "bin": {
    "agent-plugin-lifecycle": "bin/cli.js",
    "apl": "bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "format": "tsds format",
    "prepare": "tsds build",
    "prepublishOnly": "tsds validate",
    "test": "tsds test:node --no-timeouts",
    "test:apm": "tsds test:node --no-timeouts test/integration/apm-live.test.ts",
    "test:engines": "nvu engines tsds test:node --no-timeouts",
    "test:skills": "tsds test:node --no-timeouts test/integration/skills-cli.test.ts",
    "version": "tsds version"
  },
  "dependencies": {
    "cross-spawn-cb": "^3.3.1",
    "is-path-inside": "^4.0.0",
    "jsesc": "^3.1.0",
    "proper-lockfile": "^4.1.2",
    "write-file-atomic": "^7.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jsesc": "^3.0.3",
    "@types/mocha": "*",
    "@types/node": "^22",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "fs-remove-compat": "^1.1.1",
    "node-version-use": "*",
    "ts-dev-stack": "*",
    "tsds-config": "*"
  },
  "engines": {
    "node": ">=22.18"
  }
}
